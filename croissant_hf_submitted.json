  ],
  "license": "https://choosealicense.com/licenses/apache-2.0/",
  "url": "https://huggingface.co/datasets/analogyai/CFE_Benchmark",
  "rai:dataLimitations": "Coverage is uneven across the more than 20 STEM domains represented. Physics and Mathematics dominate both subsets, with engineering disciplines forming a secondary cluster and a long tail of computer science, chemistry, biology, statistics, and economics items.",
  "rai:dataBiases": "CFE-Bench is skewed toward English-language, publicly available university course materials in Physics and Mathematics, which may inflate measured capability on these subjects relative to underrepresented STEM domains and non-English educational settings.",
  "rai:personalSensitiveInformation": "None. The dataset contains no personal or sensitive information across any of the listed categories (Gender, Socio-economic status, Geography, Age, Culture, Experience/Seniority, Health, Political/Religious beliefs, or Others).",
  "rai:dataUseCases": "CFE-bench measures multi-step, instructor-validated STEM problem-solving ability on objectively verifiable college-level questions. It is validated in this paper for (i) benchmarking frontier and open-weight models, (ii) variable-based automatic evaluation of long-form responses (verified against expert labels), and (iii) step-wise reasoning diagnostics. It is \\emph{not} validated for general academic ability, open-ended/proof-style tasks, non-English settings, educational deployment decisions, or safety/fairness evaluation.",
  "rai:dataSocialImpact": "CFE-benchmark can advance rigorous evaluation of multi-step STEM reasoning and surface specific failure modes in frontier models, but risks include overgeneralization of benchmark scores to broader reasoning ability, premature educational deployment without pedagogical validation, and training-set leakage from public source materials. The benchmark's English-language and Physics/Mathematics skew may also reinforce capability gaps for underrepresented domains and non-English settings; it contains no demographic annotations and is unsuitable for fairness audits. Mitigations include documented limitations and out-of-scope uses, evaluation-only release terms, per-subject and dual-metric reporting to discourage single-number claims, and public release of the evaluation protocol for reproducibility.",
  "rai:hasSyntheticData": false
}
